# =============================================================================
# SmartWash Backend — Environment Variables
# Copy this file to .env and fill in real values before running.
# =============================================================================

# --- Database ---
# For local dev with SQLite (no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./smartwash.db

# For Docker Compose / production (Postgres):
# DATABASE_URL=postgresql+asyncpg://smartwash:smartwash@db:5432/smartwash

# --- JWT Auth ---
SECRET_KEY=change-me-to-a-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Device Auth ---
# Shared API key that ESP32 devices include in X-Device-API-Key header.
DEVICE_API_KEY=dev-device-key-change-in-production

# --- State Machine Defaults ---
# These are defaults for new machines. Each machine stores its own thresholds.
DEFAULT_START_THRESHOLD=2.0
DEFAULT_STOP_THRESHOLD=0.5
DEFAULT_START_DURATION_SECONDS=5
DEFAULT_STOP_DURATION_SECONDS=15
DEFAULT_OFFLINE_TIMEOUT_SECONDS=90

# --- Rate Limiting ---
TELEMETRY_RATE_LIMIT=60/minute
